# Copiar a .env. NUNCA subir .env al repositorio.
ENVIRONMENT=development            # development | test | production

# Producción exige postgres + redis, un JWT_SECRET de >=32 caracteres y CORS explícito.
PERSISTENCE_BACKEND=postgres       # memory | postgres
STATE_BACKEND=redis                # memory | redis
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-o-mas-caracteres

# Sin clave se usa un proveedor simulado (útil para desarrollo de UI y pruebas).
# Voz real en la nube (elige una). Gemini tiene clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
# Pipeline en cascada (STT -> LLM -> TTS): permite medir cada etapa por separado. Requiere las dos claves.
# Se elige solo si no hay clave de Gemini/OpenAI, o fuerza con VOICE_PROVIDER=cascade.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# El rol omni_app NO es superusuario, por lo que PostgreSQL aplica RLS por organización.
DATABASE_URL=postgresql+asyncpg://omni_app:omni_app@postgres:5432/omnivoice
REDIS_URL=redis://redis:6379/0
# BACKEND_PORT=8010                 # puerto del backend en tu máquina (cámbialo si está ocupado)
# FRONTEND_PORT=4310                # puerto del frontend en tu máquina
CORS_ORIGINS=["http://localhost:3000"]

MAX_SESSIONS_PER_ORG=50
RATE_LIMIT_SESSIONS_PER_MIN=20
RATE_LIMIT_API_PER_MIN=240
MAX_SESSION_SECONDS=1800

# VAD del servidor: webrtc (modelo) | energy
VAD_BACKEND=webrtc

# Telefonía (Twilio). Vacío = desactivada.
TELEPHONY_PROVIDER=none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+34910000000
# TELEPHONY_PUBLIC_URL=https://tu-dominio-publico
# HUMAN_TRANSFER_NUMBER=+34911111111

# Grabación (opt-in con consentimiento). none | local (solo desarrollo) | s3
RECORDING_STORAGE=none
# RECORDING_S3_BUCKET=
# RECORDING_S3_REGION=

# Límites de consumo y fallos de proveedor
MAX_TOTAL_SESSIONS=200             # sesiones simultáneas por proceso (todas las organizaciones)
ORG_DAILY_BUDGET_MINUTES=0         # minutos de conversación por organización y día UTC (0 = sin tope)
PROVIDER_CONNECT_TIMEOUT_S=10
PROVIDER_MAX_RECONNECTS=3          # reintentos por sesión antes de darla por perdida
# Precios de referencia para estimar el coste (USD); verifica las tarifas vigentes de tus proveedores.
# PRICE_STT_PER_MIN=0.0077
# PRICE_TTS_PER_1K_CHARS=0.030
# PRICE_LLM_IN_PER_MTOK=1.0
# PRICE_LLM_OUT_PER_MTOK=5.0
# PRICE_S2S_IN_PER_MIN=0.06
# PRICE_S2S_OUT_PER_MIN=0.24
