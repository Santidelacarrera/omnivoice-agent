{
  "uid": "omnivoice-overview",
  "title": "OmniVoice — visión general",
  "tags": [
    "omnivoice"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sesiones activas",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(omnivoice_active_sessions)",
          "legendFormat": "activas",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errores por tipo (por segundo)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 10,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(omnivoice_errors_total[5m]))",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latencia al primer audio",
      "description": "Objetivo: p50 < 0,5 s (experimental).",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(omnivoice_first_audio_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(omnivoice_first_audio_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Silencio tras interrupción (barge-in)",
      "description": "Objetivo: p95 < 0,2 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(omnivoice_barge_in_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Eventos de llamada por estado",
      "description": "outcome: applied, ignored (fuera de orden) o duplicate (repetido por el proveedor).",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status, outcome) (rate(omnivoice_call_events_total[5m]))",
          "legendFormat": "{{status}} / {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Llamadas abandonadas",
      "description": "Sin estado final: el proveedor dejó de avisar. Si crece, revisa el Status Callback.",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (from_status) (increase(omnivoice_calls_abandoned_total[1h]))",
          "legendFormat": "{{from_status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Llamadas salientes",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(omnivoice_outbound_jobs_total[10m]))",
          "legendFormat": "{{event}}",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Entregas de webhooks",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(omnivoice_webhook_deliveries_total[10m]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Herramientas: duración p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(omnivoice_tool_seconds_bucket[5m])))",
          "legendFormat": "{{tool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Coste estimado (USD/h)",
      "description": "Estimación de proveedores de voz; no es una factura.",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component) (increase(omnivoice_conversation_cost_usd_total[1h]))",
          "legendFormat": "{{component}}",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Reconexiones al proveedor de voz",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(omnivoice_provider_reconnects_total[1h]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Sesiones rechazadas por tope",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(omnivoice_budget_rejected_total[1h]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Operaciones rechazadas por plan",
      "description": "Cuotas alcanzadas (minutos, agentes, números, llamadas salientes, documentos).",
      "datasource": {
        "type": "prometheus",
        "uid": "omnivoice-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (metric) (increase(omnivoice_plan_blocked_total[1h]))",
          "legendFormat": "{{metric}}",
          "datasource": {
            "type": "prometheus",
            "uid": "omnivoice-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": []
  },
  "editable": false
}
