# Copiar a .env.production (NO subir a Git):  docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Genera cada secreto con:  openssl rand -hex 32
APP_DOMAIN=app.ejemplo.com                 # DNS A apuntando al servidor; Caddy emite el certificado solo
API_DOMAIN=api.ejemplo.com
PUBLIC_API_URL=https://api.ejemplo.com     # se incrusta en el frontend al compilar
CORS_ORIGINS=["https://app.ejemplo.com"]
JWT_SECRET=CAMBIAR
POSTGRES_PASSWORD=CAMBIAR
OMNI_APP_PASSWORD=CAMBIAR                   # hex: va dentro de la URL de conexión
GRAFANA_ADMIN_PASSWORD=CAMBIAR
OPENAI_API_KEY=
# GEMINI_API_KEY=
